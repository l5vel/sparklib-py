# /etc/sudoers.d/canbus
#
# Lets the driver recover a wedged USB CAN adapter without a password and
# without granting a shell. Install with:
#
#     sudo install -m 0440 system/canbus.sudoers /etc/sudoers.d/canbus
#     sudo visudo -c
#
# Replace YOURUSER with the account that runs the code. `tee` is used rather
# than a shell redirect so the grant names two exact sysfs nodes instead of
# `sh -c`, which would be a root shell in all but name.
YOURUSER ALL=(root) NOPASSWD: /usr/bin/tee /sys/bus/usb/drivers/gs_usb/unbind
YOURUSER ALL=(root) NOPASSWD: /usr/bin/tee /sys/bus/usb/drivers/gs_usb/bind
YOURUSER ALL=(root) NOPASSWD: /usr/sbin/ip link set can_spark *
YOURUSER ALL=(root) NOPASSWD: /usr/sbin/tc qdisc del dev can_spark root

# A stalled USB endpoint needs a real re-enumeration, which a driver rebind does
# not perform. This is the hub port the adapter sits on; find yours with
# `spark canfix` and add the exact path it prints.
# YOURUSER ALL=(root) NOPASSWD: /usr/bin/tee /sys/bus/usb/devices/3-1/3-1:1.0/3-1-port2/disable
